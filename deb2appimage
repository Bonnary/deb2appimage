#!/usr/bin/env bash
# deb2appimage - wrap a .deb payload in an AppImage, install existing AppImages,
# and uninstall AppImages.
# Usage: deb2appimage [--yes] [package.deb]
#        deb2appimage install [--yes] [path.AppImage]
#        deb2appimage uninstall [--yes] [path.AppImage]
set -eu

DEST="$HOME/Applications"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/deb2appimage"
TOOL="$CACHE/appimagetool-x86_64.AppImage"
TOOL_URL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"
ASSUME_YES=0

# 64x64 grey PNG used when a package ships no icon
FALLBACK_ICON="iVBORw0KGgoAAAANSUhEUgAAAEAAAABACAIAAAAlC+aJAAAATElEQVR42u3PMQ0AAAwDoEqsfzWVsHsJOCB9LgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgIClwFlmwDi/L+BBwAAAABJRU5ErkJggg=="

die() { gum style --foreground 1 "✗ $*" >&2; exit 1; }
step() { gum style --foreground 5 "→ $*"; }
ok() { gum style --foreground 2 "✓ $*"; }
note() { gum style --foreground 3 "$*"; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

confirm() {
  ((ASSUME_YES)) && return 0
  gum confirm "$1"
}

extract_tar() { # extract_tar <archive> <dir>
  local f=$1 d=$2
  case "$f" in
    *.xz)  need xz; tar -xJf "$f" -C "$d" ;;
    *.gz)  tar -xzf "$f" -C "$d" ;;
    *.bz2) tar -xjf "$f" -C "$d" ;;
    *.zst) need zstd; tar --zstd -xf "$f" -C "$d" ;;
    *)     tar -xf "$f" -C "$d" ;;
  esac
}

ensure_tool() {
  [[ -x $TOOL ]] && return 0
  step "appimagetool not cached (~15 MB download)"
  confirm "Download appimagetool to $CACHE?" || die "appimagetool required"
  mkdir -p "$CACHE"
  curl -fL --retry 3 --progress-bar -o "$TOOL" "$TOOL_URL" || die "download failed"
  chmod +x "$TOOL"
}

pick_desktop() { # pick_desktop <root>; sets DESKTOP, BIN
  local root=$1 d exec_line cand base found toks
  DESKTOP="" BIN=""
  for d in "$root"/usr/share/applications/*.desktop; do
    [[ -f $d ]] || continue
    exec_line=$(sed -n 's/^Exec=//p' "$d" | head -1)
    [[ -n $exec_line ]] || continue
    read -ra toks <<< "$exec_line"
    [[ ${toks[0]:-} == env ]] && toks=("${toks[@]:1}")
    while [[ ${toks[0]:-} == *=* ]]; do toks=("${toks[@]:1}"); done
    cand=${toks[0]:-}
    [[ -n $cand ]] || continue
    if [[ $cand == /* && -x $root$cand ]]; then
      DESKTOP=$d BIN=$root$cand; return 0
    fi
    base=$(basename "$cand")
    found=$(find "$root" -name "$base" -type f -perm -u+x -print -quit)
    if [[ -n $found ]]; then
      DESKTOP=$d BIN=$found; return 0
    fi
  done
  return 1
}

pick_icon() { # pick_icon <root> <desktop>; echoes path of best icon
  local root=$1 desk=$2 name path
  name=""
  [[ -n $desk ]] && name=$(sed -n 's/^Icon=//p' "$desk" | head -1)
  path=""
  if [[ -n $name ]]; then
    path=$(find "$root" \( -path '*/icons/*' -o -path '*/pixmaps/*' \) \( -name "$name.png" -o -name "$name.svg" \) \
             -printf '%s %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
  fi
  if [[ -z $path ]]; then
    path=$(find "$root" \( -path '*/icons/*' -o -path '*/pixmaps/*' \) \( -name '*.png' -o -name '*.svg' \) \
             -printf '%s %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
  fi
  printf '%s' "$path"
}

pick_appimage_icon() { # pick_appimage_icon <root> <desktop>; echoes path of best icon
  local root=$1 desk=$2 name path
  name=""
  [[ -n $desk ]] && name=$(sed -n 's/^Icon=//p' "$desk" | head -1)
  if [[ -n $name ]]; then
    for path in "$root/$name.png" "$root/$name.svg"; do
      [[ -f $path ]] && { printf '%s' "$path"; return; }
    done
    path=$(pick_icon "$root" "$desk")
    [[ -n $path ]] && { printf '%s' "$path"; return; }
  fi
  if [[ -L $root/.DirIcon ]]; then
    path=$(readlink -f "$root/.DirIcon")
    [[ -f $path ]] && { printf '%s' "$path"; return; }
  fi
  path=$(find "$root" \( -name '*.png' -o -name '*.svg' \) \
           -printf '%s %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
  printf '%s' "$path"
}

launch_offer() { # launch_offer <appimage>
  local apps="$HOME/.local/share/applications" pid i
  # Only apps that register their entry on first run need this. Launch and close
  # automatically: own session and no tty, so setup noise cannot hold the terminal.
  if ! grep -qsF -- "$1" "$apps"/*.desktop; then
    setsid "$1" </dev/null >/dev/null 2>&1 &
    pid=$!
    for i in {1..100}; do
      sleep 0.2
      kill -0 -- "-$pid" 2>/dev/null || break
      grep -qsF -- "$1" "$apps"/*.desktop && break
    done
    sleep 2 # let the remaining setup (icons, mime types) finish
    # Kill the whole group: the AppImage wrapper forks, so the pid alone is not enough.
    kill -TERM -- "-$pid" 2>/dev/null || true
    for i in {1..10}; do kill -0 -- "-$pid" 2>/dev/null || break; sleep 0.2; done
    kill -KILL -- "-$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  hide_uri_handlers "$1"
  update-desktop-database "$apps" >/dev/null 2>&1 || true
}

integrate() { # integrate <appimage> <desktop> <icon> <icon-name>
  local img=$1 desk=$2 icon=$3 base=$4 ext dest apps icons
  ext=${icon##*.}
  apps="$HOME/.local/share/applications"
  icons="$HOME/.local/share/icons/hicolor"
  mkdir -p "$apps"
  if [[ $ext == svg ]]; then
    dest="$icons/scalable/apps/$base.svg"
  else
    dest="$icons/256x256/apps/$base.png"
  fi
  mkdir -p "$(dirname "$dest")"
  cp "$icon" "$dest"
  sed -e "s|^Exec=.*|Exec=\"$img\" %F|" -e "s|^TryExec=.*|TryExec=$img|" \
      -e "s|^Icon=.*|Icon=$base|" "$desk" > "$apps/$base.desktop"
  chmod +x "$apps/$base.desktop"
  gtk-update-icon-cache -f -t "$icons" >/dev/null 2>&1 || true
  update-desktop-database "$apps" >/dev/null 2>&1 || true
}

hide_uri_handlers() { # hide_uri_handlers <appimage>
  local img=$1 f
  for f in "$HOME"/.local/share/applications/*.desktop; do
    [[ -f $f ]] || continue
    grep -qF -- "$img" "$f" || continue
    grep -qE '^Exec=.*(-uri=|%u)' "$f" || continue
    grep -q '^NoDisplay=' "$f" || printf 'NoDisplay=true\n' >> "$f"
  done
  update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
}

install_deb() {
  local deb=${1:-} tmp pkg ver data control root appdir out rel name icon icon_ext build_log
  local safe_pkg safe_ver icon_base bundled f
  if [[ -z $deb ]]; then
    need gum
    local -a found
    mapfile -t found < <(find "$HOME/Downloads" "$PWD" -maxdepth 1 -type f -name '*.deb' 2>/dev/null | sort -u)
    if ((${#found[@]})); then
      deb=$(gum filter --header "Select .deb package" -- "${found[@]}") || exit 0
    else
      deb=$(gum input --header "Path to .deb" --placeholder "$HOME/Downloads/package.deb") || exit 0
    fi
  fi
  [[ -f $deb ]] || die "no such file: $deb"

  need gum; need ar; need tar; need find; need curl

  tmp=$(mktemp -d)
  trap "rm -rf $(printf %q "$tmp")" EXIT

  ar t "$deb" 2>/dev/null | grep -q '^control\.tar' || die "not a .deb: $deb"
  mkdir -p "$tmp/deb"
  (cd "$tmp/deb" && ar x "$deb")
  control=$(find "$tmp/deb" -maxdepth 1 -name 'control.tar.*' -print -quit)
  data=$(find "$tmp/deb" -maxdepth 1 -name 'data.tar.*' -print -quit)
  [[ -n $data ]] || die "no data.tar.* in $deb"

  mkdir -p "$tmp/control" "$tmp/root"
  extract_tar "$control" "$tmp/control"
  pkg=$(sed -n 's/^Package: //p' "$tmp/control/control" | head -1)
  ver=$(sed -n 's/^Version: //p' "$tmp/control/control" | head -1)
  [[ -n $pkg ]] || die "control file has no Package field"

  step "Extracting ${pkg} ${ver:-}"
  extract_tar "$data" "$tmp/root"
  root=$tmp/root

  # some vendors ship a ready-made AppImage inside the .deb (e.g. Packet Tracer)
  bundled=""
  while IFS= read -r -d '' f; do
    case $(head -c 11 "$f" | tail -c 3 | od -An -tx1 | tr -d ' \n') in
      414901|414902) bundled=$f; break ;;
    esac
  done < <(find "$root" -type f -perm -u+x -print0 2>/dev/null)

  if [[ -n $bundled ]]; then
    safe_pkg=${pkg//[^A-Za-z0-9._-]/_}
    safe_ver=${ver//[^A-Za-z0-9._-]/_}
    mkdir -p "$DEST"
    out="$DEST/${safe_pkg}-${safe_ver:-unknown}-x86_64.AppImage"
    note "Payload already contains an AppImage; extracting it unchanged"
    if [[ -e $out ]] && ! confirm "Overwrite existing $out?"; then
      ok "Cancelled"; return 0
    fi
    cp "$bundled" "$out" || die "copy failed"
    chmod +x "$out"
    ok "Created $out"

    # Packet Tracer keeps an "active" marker in ~/.local/.packettracer and skips
    # re-registration while it exists, even if the launcher entry was deleted.
    if [[ -f $HOME/.local/.packettracer/active-version ]] &&
       ! grep -qsF "$out" "$HOME"/.local/share/applications/*.desktop; then
      note "Clearing stale launcher registration"
      rm -f "$HOME/.local/.packettracer/active-version"
    fi
    launch_offer "$out"
    hide_uri_handlers "$out"
    return 0
  fi

  if pick_desktop "$root"; then
    name=$(sed -n 's/^Name=//p' "$DESKTOP" | head -1)
  else
    BIN=$(find "$root/usr/bin" "$root/usr/local/bin" -maxdepth 1 -type f -perm -u+x -print 2>/dev/null | sort | head -1)
    [[ -n $BIN ]] || die "no .desktop entry and no executable in usr/bin; cannot convert automatically"
    note "No .desktop entry; using $(basename "$BIN")"
  fi
  name=${name:-$pkg}
  rel=${BIN#"$root"}

  # xdg variants are covered by the icons path; ignore xpm, appimagetool wants png/svg
  icon=$(pick_icon "$root" "${DESKTOP:-}")
  if [[ -z $icon ]]; then
    printf '%s' "$FALLBACK_ICON" | base64 -d > "$tmp/fallback.png"
    icon=$tmp/fallback.png
  fi
  icon_ext=${icon##*.}

  safe_pkg=${pkg//[^A-Za-z0-9._-]/_}
  safe_ver=${ver//[^A-Za-z0-9._-]/_}
  icon_base=$safe_pkg

  appdir=$tmp/AppDir
  mkdir -p "$appdir"
  cp -a "$root/." "$appdir/"

  cat > "$appdir/AppRun" <<EOF
#!/bin/sh
HERE="\$(dirname "\$(readlink -f "\$0")")"
export PATH="\$HERE/usr/bin:\$HERE/bin:\$HERE/usr/local/bin:\$PATH"
export LD_LIBRARY_PATH="\$HERE/usr/lib:\$HERE/usr/lib/x86_64-linux-gnu\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="\$HERE/usr/share:\${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
exec "\$HERE$rel" "\$@"
EOF
  chmod +x "$appdir/AppRun"

  cp "$icon" "$appdir/$icon_base.$icon_ext"
  cp "$icon" "$appdir/.DirIcon"

  if [[ -n $DESKTOP ]]; then
    sed -e "s|^Exec=.*|Exec=$(basename "$BIN")|" \
        -e "s|^Icon=.*|Icon=$icon_base|" \
        -e "s|^TryExec=.*|TryExec=$(basename "$BIN")|" \
        "$DESKTOP" > "$appdir/$(basename "$DESKTOP")"
  else
    cat > "$appdir/$safe_pkg.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Exec=$(basename "$BIN")
Icon=$icon_base
Categories=Utility;
Terminal=true
EOF
  fi
  local desk_file
  desk_file=$(find "$appdir" -maxdepth 1 -name '*.desktop' -print -quit)
  grep -q '^X-AppImage-Version=' "$desk_file" \
    || printf '\nX-AppImage-Version=%s\n' "${ver:-unknown}" >> "$desk_file"

  mkdir -p "$DEST"
  out="$DEST/${safe_pkg}-${safe_ver:-unknown}-x86_64.AppImage"

  gum style --border rounded --padding '0 1' --margin '0 0 1 0' \
    "$(printf 'Package : %s\nVersion : %s\nApp     : %s\nBinary  : %s\nOutput  : %s' \
      "$pkg" "${ver:-unknown}" "$name" "$rel" "$out")"

  if [[ -e $out ]] && ! confirm "Overwrite existing $out?"; then
    ok "Cancelled"; return 0
  fi

  ensure_tool
  step "Building AppImage"
  build_log=$tmp/build.log
  if ! APPIMAGE_EXTRACT_AND_RUN=1 ARCH=x86_64 "$TOOL" "$appdir" "$out" >"$build_log" 2>&1; then
    tail -5 "$build_log" >&2
    die "appimagetool failed (log: $build_log)"
  fi
  chmod +x "$out"

  ok "Created $out"
  integrate "$out" "$desk_file" "$icon" "$icon_base"
  note "Added launcher entry $safe_pkg.desktop"
  note "Dependencies are not bundled: the app still needs its system libraries."
  launch_offer "$out"
}

install_appimage() {
  local img=${1:-} tmp out base desk icon
  if [[ -z $img ]]; then
    need gum
    local -a found
    mapfile -t found < <(find "$HOME/Downloads" "$PWD" -maxdepth 1 -type f -name '*.AppImage' 2>/dev/null | sort -u)
    if ((${#found[@]})); then
      img=$(gum filter --header "Select .AppImage" -- "${found[@]}") || exit 0
    else
      img=$(gum input --header "Path to .AppImage" --placeholder "$HOME/Downloads/app.AppImage") || exit 0
    fi
  fi
  [[ -f $img ]] || die "no such file: $img"
  need gum

  base=$(basename "$img")
  [[ $base == *.AppImage ]] || die "not an .AppImage: $img"
  out="$DEST/$base"
  if [[ -e $out && ! $img -ef $out ]] && ! confirm "Overwrite existing $out?"; then
    ok "Cancelled"; return 0
  fi
  mkdir -p "$DEST"
  if [[ ! $img -ef $out ]]; then
    cp "$img" "$out" || die "copy failed"
  fi
  chmod +x "$out"

  tmp=$(mktemp -d)
  trap "rm -rf $(printf %q "$tmp")" EXIT
  step "Reading AppImage metadata"
  if ! ( cd "$tmp" && "$out" --appimage-extract ) >/dev/null 2>&1; then
    die "cannot extract $out (is it a valid AppImage?)"
  fi

  desk=$(find "$tmp/squashfs-root" -maxdepth 1 -name '*.desktop' -print -quit)
  [[ -n $desk ]] || die "no .desktop entry found in $out"
  base=$(basename "$desk" .desktop)
  base=${base//[^A-Za-z0-9._-]/_}
  icon=$(pick_appimage_icon "$tmp/squashfs-root" "$desk")
  if [[ -z $icon ]]; then
    printf '%s' "$FALLBACK_ICON" | base64 -d > "$tmp/fallback.png"
    icon=$tmp/fallback.png
  fi

  integrate "$out" "$desk" "$icon" "$base"
  ok "Installed $out"
  note "Added launcher entry $base.desktop"
}

uninstall_appimage() {
  local -a images
  local target=$1 desktop
  need gum
  mapfile -t images < <(find "$DEST" -maxdepth 1 -type f -name '*.AppImage' 2>/dev/null | sort)
  if ((${#images[@]} == 0)); then
    [[ -n $target ]] || die "no AppImages in $DEST"
  elif [[ -z $target ]]; then
    target=$(gum choose --header "Remove which AppImage?" "${images[@]}") || exit 0
  fi
  [[ -f $target ]] || die "no such AppImage: $target"
  confirm "Delete $target?" || { ok "Cancelled"; return 0; }

  rm -f "$target"
  ok "Deleted $target"

  # Drop a stale Packet Tracer "active" marker, otherwise a reinstall skips
  # registering its launcher entry.
  if [[ -f $HOME/.local/.packettracer/active-version ]] &&
     grep -qF "$target" "$HOME/.local/.packettracer/active-version"; then
    rm -f "$HOME/.local/.packettracer/active-version"
    note "Reset Packet Tracer activation marker"
  fi

  local icon iconfile
  while IFS= read -r desktop; do
    [[ -f $desktop ]] || continue
    icon=$(sed -n 's/^Icon=//p' "$desktop" | head -1)
    rm -f "$desktop"
    ok "Removed launch entry $(basename "$desktop")"
    if [[ -n $icon ]]; then
      while IFS= read -r iconfile; do rm -f "$iconfile"; done < <(
        find "$HOME/.local/share/icons" \( -name "$icon.png" -o -name "$icon.svg" -o -name "$icon.xpm" \) 2>/dev/null
      )
    fi
  done < <(grep -lF "$target" "$HOME"/.local/share/applications/*.desktop 2>/dev/null || true)

  gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
  update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
  note "App data in ~/.local and ~/.config was left untouched."
}

target_arg=""
case "${1:-}" in
  uninstall)
    shift
    for a in "$@"; do
      case "$a" in
        -y|--yes) ASSUME_YES=1 ;;
        *)        target_arg=$a ;;
      esac
    done
    uninstall_appimage "$target_arg"
    ;;
  install)
    shift
    for a in "$@"; do
      case "$a" in
        -y|--yes) ASSUME_YES=1 ;;
        *)        target_arg=$a ;;
      esac
    done
    install_appimage "$target_arg"
    ;;
  -y|--yes) ASSUME_YES=1; shift; install_deb "${1:-}" ;;
  -h|--help)
    cat <<'USAGE'
deb2appimage - convert a .deb into an AppImage

Usage:
  deb2appimage [--yes] [package.deb]   convert (TUI file picker if no path)
  deb2appimage install [--yes] [file]  copy an AppImage to ~/Applications
  deb2appimage uninstall [--yes] [file] delete an AppImage from ~/Applications
USAGE
    ;;
  *)
    if [[ -z ${1:-} ]]; then
      need gum
      action=$(gum choose --header "deb2appimage" "Install .deb → AppImage" "Install .AppImage" "Uninstall AppImage") || exit 0
      case "$action" in
        "Install .deb"*)   install_deb ;;
        "Install .AppImage"*) install_appimage "" ;;
        "Uninstall"*)      uninstall_appimage "" ;;
      esac
    else
      install_deb "$@"
    fi
    ;;
esac
